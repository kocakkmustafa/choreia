build/
.dart_tool/
node_modules/
*.log
harvest/media/
harvest/*.mp4

# Hasat ara çıktıları: hattan yeniden üretilebilir, git%27e girmez (48 MB dersi)
harvest/fixtures/
harvest/media/
harvest/probe.json

# Flutter üretilen (JabLab deseni): eklenti çözümü makineye özel, git'e girmez
.flutter-plugins-dependencies

# Python bytecode: üretilir, git%27e girmez — her regen sonrası diff%27i kirletiyordu
# (C-113 dersi: diff okunabilir kalmalı, kayıpları YAKALAYAN şey o)
__pycache__/
*.pyc

# iCloud dışına symlink'lenmiş build çıktısı (memory: feedback-lifeos-icloud-build)
/build

# Poz modeli ikilisi — aile kuralı `.task` dosyalarını izlemiyor (9,4 MB her
# klonda taşınmaz). `tool/fetch_pose_model.sh` indirir/kopyalar ve SHA-256
# doğrular; pin `lib/app/live/pose_model.dart`'ta yaşar.
*.task

# CHO-P0-002 — self-hosted google_fonts dosyaları. AYNI desen: pinli SHA-256
# `tool/fetch_fonts.sh`'ta yaşar, ikili git'e girmez (lissom L-348 emsali).
/assets/fonts/
