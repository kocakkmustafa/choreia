{
  "schemaVersion": 1,
  "id": "ss_basic",
  "style": "salsa_shines",
  "name": { "en": "Salsa Basic (solo)" },
  "level": 1,
  "beats": 8,
  "countLabels": ["1", "2", "3", "4", "5", "6", "7", "8"],
  "note": "Forward-and-back basic danced solo. Counts 4 and 8 are held, not stepped — the pause is part of the step and learners who fill it are dancing a different rhythm.",

  "measurability": {
    "tier": "A",
    "rationale": "Weight transfer produces large thigh-orientation and knee-flexion changes. Step direction is fronto-parallel to the camera. No turns in the basic.",
    "riskFlags": [
      "Step size is small relative to hip-hop; amplitude thresholds must be calibrated against real takes before shipping (plan §12.4)."
    ]
  },

  "scoring": {
    "focusJoints": [
      "left_thigh", "right_thigh", "left_knee", "right_knee",
      "left_hip", "right_hip", "trunk_tilt"
    ],
    "freeJoints": [
      "left_upper_arm", "right_upper_arm", "left_forearm", "right_forearm",
      "left_elbow", "right_elbow", "left_shoulder", "right_shoulder"
    ],
    "freeJointsRationale": "Arm carriage in solo salsa varies widely between schools. V1 scores footwork and timing only, and says so to the user (plan C-014).",
    "toleranceProfile": "beginner"
  },

  "phases": [
    {
      "id": "ready",
      "enter": { "metric": "weight_balance", "op": "centered", "toleranceDeg": 6 },
      "requiredLandmarks": ["leftLeg", "rightLeg", "torso"],
      "timeoutMs": 3000
    },
    {
      "id": "fwd_step",
      "enter": { "metric": "left_thigh_forward", "op": ">", "valueDeg": 12 },
      "requiredLandmarks": ["leftLeg", "torso"],
      "timeoutMs": 900
    },
    {
      "id": "fwd_replace",
      "enter": { "metric": "weight_side", "op": "==", "value": "right" },
      "requiredLandmarks": ["leftLeg", "rightLeg", "torso"],
      "timeoutMs": 900
    },
    {
      "id": "fwd_close",
      "enter": { "metric": "weight_balance", "op": "centered", "toleranceDeg": 8 },
      "requiredLandmarks": ["leftLeg", "rightLeg", "torso"],
      "timeoutMs": 900
    },
    {
      "id": "hold_4",
      "enter": { "metric": "feet_settled", "op": "true" },
      "requiredLandmarks": ["leftLeg", "rightLeg"],
      "minDurationMs": 120,
      "timeoutMs": 900
    },
    {
      "id": "back_step",
      "enter": { "metric": "right_thigh_back", "op": ">", "valueDeg": 12 },
      "requiredLandmarks": ["rightLeg", "torso"],
      "timeoutMs": 900
    },
    {
      "id": "back_replace",
      "enter": { "metric": "weight_side", "op": "==", "value": "left" },
      "requiredLandmarks": ["leftLeg", "rightLeg", "torso"],
      "timeoutMs": 900
    },
    {
      "id": "back_close",
      "enter": { "metric": "weight_balance", "op": "centered", "toleranceDeg": 8 },
      "requiredLandmarks": ["leftLeg", "rightLeg", "torso"],
      "timeoutMs": 900,
      "isTerminal": true
    }
  ],

  "scoredMoments": [
    { "id": "step_1", "phase": "fwd_step", "beat": 0, "label": "1" },
    { "id": "step_2", "phase": "fwd_replace", "beat": 1, "label": "2" },
    { "id": "step_3", "phase": "fwd_close", "beat": 2, "label": "3" },
    { "id": "step_5", "phase": "back_step", "beat": 4, "label": "5" },
    { "id": "step_6", "phase": "back_replace", "beat": 5, "label": "6" },
    { "id": "step_7", "phase": "back_close", "beat": 6, "label": "7" }
  ],

  "errors": [
    {
      "code": "NO_WEIGHT_TRANSFER",
      "severity": "critical",
      "detect": {
        "metric": "loaded_leg_knee_change",
        "op": "<",
        "valueDeg": 8,
        "atMoments": ["step_1", "step_3", "step_5", "step_7"]
      },
      "evidence": ["left_knee", "right_knee", "loaded_leg_knee_change"],
      "relatedDrill": "ss_weight_shift",
      "note": "Marking the step with the foot without committing weight. The defining beginner fault in every social dance and the reason the basic is scored on weight, not foot position."
    },
    {
      "code": "STEP_MISSED_ON_4",
      "severity": "major",
      "detect": {
        "metric": "movement_during_hold",
        "op": ">",
        "valueDeg": 10,
        "atMoments": ["hold_4"]
      },
      "evidence": ["movement_during_hold"],
      "relatedDrill": "ss_count_hold",
      "note": "Stepping on 4 turns the salsa basic into a march. Detecting it needs the hold to be an explicit phase, which is why hold_4 exists."
    },
    {
      "code": "WRONG_FOOT",
      "severity": "critical",
      "detect": {
        "metric": "leading_side",
        "op": "!=",
        "expected": "reference",
        "atMoments": ["step_1", "step_5"]
      },
      "evidence": ["leading_side"],
      "relatedDrill": "ss_lead_foot",
      "note": "Only meaningful once mirroring is resolved on the reference side — see catalogue §6.0 and C-005. A mirror error here would blame the learner for our own bug."
    },
    {
      "code": "STEP_TOO_LARGE",
      "severity": "minor",
      "detect": {
        "metric": "step_thigh_excursion",
        "op": ">",
        "valueDeg": 38
      },
      "evidence": ["left_thigh", "right_thigh"],
      "relatedDrill": "ss_small_steps"
    },
    {
      "code": "STEP_LATE",
      "severity": "major",
      "detect": {
        "metric": "timing_verdict",
        "op": "in",
        "values": ["late", "offBeat"],
        "atMoments": ["step_1", "step_2", "step_3", "step_5", "step_6", "step_7"]
      },
      "evidence": ["timing_offset_ms", "timing_verdict"],
      "relatedDrill": "ss_slow_tempo",
      "note": "Suppressed when TimingSummary.suggestsCalibrationIssue is true — a large, tight bias is uncalibrated audio, not a dragging dancer (plan §9.2)."
    }
  ],

  "reference": {
    "requiredTakes": 6,
    "collectedTakes": 0,
    "status": "pending"
  }
}
